# Nacho Bot works with no keys at all: it falls back to Pollinations'
# free, keyless gpt-oss-20b. Set these for a stronger model or higher limits.

# Groq free tier — https://console.groq.com/keys (gpt-oss-120b, also used for prediction insights)
GROQ_API_KEY=

# Optional Pollinations token for higher rate limits — https://auth.pollinations.ai
POLLINATIONS_TOKEN=

# Absolute site URL for Open Graph images (defaults to the Vercel production domain)
NEXT_PUBLIC_SITE_URL=
